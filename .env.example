# Corel workspace backend (Supabase). These two values are PUBLIC by design:
# the anon key only grants what the row level security policies in
# supabase/migrations allow. Never put the service_role key here.
COREL_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
COREL_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
